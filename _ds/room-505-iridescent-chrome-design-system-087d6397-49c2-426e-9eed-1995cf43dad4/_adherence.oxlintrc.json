{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/studio_archive/**",
              "ui_kits/studio_archive_v1/**",
              "ui_kits/studio_archive_v2/**",
              "ui_kits/studio_archive_v2_m2/**",
              "ui_kits/studio_site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:spectrum|cyan|indigo|magenta|neutral|success|danger)$/]",
        "message": "<Badge> tone must be one of 'spectrum' | 'cyan' | 'indigo' | 'magenta' | 'neutral' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|fullWidth|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, fullWidth, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|chrome|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'chrome' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:glow|interactive|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: glow, interactive, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:none|cyan|indigo|magenta)$/]",
        "message": "<Card> glow must be one of 'none' | 'cyan' | 'indigo' | 'magenta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChromeHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|spectrum|sheen|glow|key|ref|className|style|children)$/]",
        "message": "<ChromeHeading> doesn't accept that prop. Declared props: as, size, spectrum, sheen, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChromeHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|div|span)$/]",
        "message": "<ChromeHeading> as must be one of 'h1' | 'h2' | 'h3' | 'div' | 'span'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChromeHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|display|md|sm)$/]",
        "message": "<ChromeHeading> size must be one of 'hero' | 'display' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChromeHeading'] > JSXAttribute[name.name='spectrum'] > Literal[value!=/^(?:cool|warm)$/]",
        "message": "<ChromeHeading> spectrum must be one of 'cool' | 'warm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|eyebrow|title|footer|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, eyebrow, title, footer, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrainOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:intensity|scanlines|grainSrc|key|ref|className|style|children)$/]",
        "message": "<GrainOverlay> doesn't accept that prop. Declared props: intensity, scanlines, grainSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrainOverlay'] > JSXAttribute[name.name='intensity'] > Literal[value!=/^(?:ui|poster|heavy)$/]",
        "message": "<GrainOverlay> intensity must be one of 'ui' | 'poster' | 'heavy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|variant|label|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, variant, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<IconButton> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiquidBlob'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|shape|spectrum|drift|key|ref|className|style|children)$/]",
        "message": "<LiquidBlob> doesn't accept that prop. Declared props: size, shape, spectrum, drift."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiquidBlob'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:drop|ribbon|pill)$/]",
        "message": "<LiquidBlob> shape must be one of 'drop' | 'ribbon' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiquidBlob'] > JSXAttribute[name.name='spectrum'] > Literal[value!=/^(?:cool|warm)$/]",
        "message": "<LiquidBlob> spectrum must be one of 'cool' | 'warm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='NeonGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|hue|horizonGlow|key|ref|className|style|children)$/]",
        "message": "<NeonGrid> doesn't accept that prop. Declared props: height, hue, horizonGlow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|name|value|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, onChange, label, name, value, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlashLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:closed|tone|size|key|ref|className|style|children)$/]",
        "message": "<SlashLabel> doesn't accept that prop. Declared props: closed, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlashLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|secondary|cyan|bright)$/]",
        "message": "<SlashLabel> tone must be one of 'muted' | 'secondary' | 'cyan' | 'bright'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlashLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SlashLabel> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onRemove|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: active, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|onClose|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, title, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Toast> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|placement|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: content, placement."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom|left|right)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom' | 'left' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
